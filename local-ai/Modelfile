FROM qwen3:4b

SYSTEM /no_think

# Context window size in tokens (sized for a 6 GB GPU)
PARAMETER num_ctx 8192
# Maximum tokens generated per response
PARAMETER num_predict 4096
# Sampling settings
PARAMETER repeat_penalty 1.15
PARAMETER repeat_last_n 256
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER top_k 40
# Tokens from the start of the prompt kept when the context is truncated
PARAMETER num_keep 24
